    "elementGeneration": {
      "木": "火",
      "火": "土",
      "土": "金",
      "金": "水",
      "水": "木"
    },
    "elementControl": {
      "木": "土",
      "土": "水",
      "水": "火",
      "火": "金",
      "金": "木"
    },
    "combinePairs": [
      {
        "members": [
          "jia",
          "ji"
        ],
        "resultElement": "土"
      },
      {
        "members": [
          "yi",
          "geng"
        ],
