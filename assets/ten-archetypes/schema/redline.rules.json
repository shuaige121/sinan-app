{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dao.leonardchow.work/schema/redline.rules.json",
  "schemaVersion": "sinan/redlines@1",
  "title": "常明城人物红线 · 可执行规则",
  "sourcePaths": {
    "manifest": "../characters/manifest.json",
    "registry": "../../../www/dian/data/registry.json",
    "textsDir": "../../../www/dian/data/texts",
    "annotatedDir": "../../../www/dian/data/annotated"
  },
  "factionCatalog": {
    "builtIns": [
      {
        "id": "mingli-zong",
        "labelZh": "命理宗"
      },
      {
        "id": "xingshi-pai",
        "labelZh": "形势派"
      },
      {
