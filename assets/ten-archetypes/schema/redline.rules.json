      ],
      [
        "yi",
        "xin"
      ],
      [
        "bing",
        "ren"
      ],
      [
        "ding",
        "gui"
      ]
    ],
    "tenGodAlgorithm": {
      "sameElement": {
        "samePolarity": "比肩",
        "oppositePolarity": "劫财"
      },
      "selfGeneratesTarget": {
        "samePolarity": "食神",
        "oppositePolarity": "伤官"
      },
      "targetGeneratesSelf": {
        "samePolarity": "偏印",
        "oppositePolarity": "正印"
