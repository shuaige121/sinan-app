    "exclusiveHighlightActions": {
      "shou": {
        "verbZh": "守",
        "ownerId": "ding",
        "reviewPatterns": [
          "守(?:住|着|護|护|候|到|在)"
        ]
      },
      "hua": {
        "verbZh": "画",
        "ownerId": "yi",
        "reviewPatterns": [
          "画(?:出|下|成|一|這|这|那|新|回)"
        ]
      },
      "luo": {
        "verbZh": "落",
        "ownerId": "geng",
        "reviewPatterns": [
          "落(?:下|刀|手)",
          "下刀"
        ]
      },
      "kai": {
        "verbZh": "开",
        "ownerId": "wu",
        "reviewPatterns": [
          "(?:亲手)?开(?:门|闸|閘)",
          "打开[^，。；！？]{0,8}(?:门|闸|閘)"
        ],
        "explicitNonMatches": [
