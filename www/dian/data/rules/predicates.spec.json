    "has_branch": { "args": { "zhi": "zhi", "where": "pos?" }, "engine": "ready", "src": "四柱地支" },
    "has_element": { "args": { "el": "element", "min": "int?" }, "engine": "ready", "src": "天干+地支本气；计数口径=天干1+本气1" },
    "pillar_gan": { "args": { "pos": "pos", "gan": "gan" }, "engine": "ready", "src": "core.js" },
    "pillar_zhi": { "args": { "pos": "pos", "zhi": "zhi" }, "engine": "ready", "src": "core.js" },
    "nayin": { "args": { "pos": "pos", "v": "string(纳音30)" }, "engine": "ready", "src": "core.js mkPillar" },
    "month_branch": { "args": { "zhi": "zhi" }, "engine": "ready", "src": "core.js" },
    "season": { "args": { "v": "season" }, "engine": "ready", "src": "月支映射" },
    "ten_god_present": { "args": { "god": "ten_god", "where": "pos?" }, "engine": "pending:shishen", "src": "lunar-js getXxxShiShenGan/Zhi（含藏干），待接线" },
    "ten_god_at": { "args": { "pos": "pos", "god": "ten_god" }, "engine": "pending:shishen", "src": "同上（天干位）" },
    "ten_god_count": { "args": { "god": "ten_god", "cmp": "cmp", "n": "int" }, "engine": "pending:shishen", "src": "天干+藏干展开计数；n 只准来自原句明数或该句 quant" },
    "twelve_stage": { "args": { "zhi": "zhi", "stage": "twelve_stage" }, "engine": "pending:dishi", "src": "lunar-js getXxxDiShi；语义=日主在该支的长生宫" },
    "branch_relation": { "args": { "rel": "branch_rel", "members": "zhi[]" }, "engine": "pending:branchrel", "src": "自建 40 行常量表（六冲6/六合6/三合4/三会4/六害6/三刑3+自刑4）" },
    "stem_combo": { "args": { "pair": "gan[2]" }, "engine": "pending:branchrel", "src": "天干五合常量" },
    "gaitou": { "args": { "gan": "gan", "zhi": "zhi" }, "engine": "ready", "src": "同柱天干克地支本气" },
    "tougan": { "args": { "gan": "gan" }, "engine": "ready", "src": "地支藏干透于天干" },
    "xunkong": { "args": { "zhi": "zhi" }, "engine": "ready", "src": "core.js:292 日柱旬空" },
    "shensha": { "args": { "name": "shensha" }, "engine": "pending:shensha", "src": "自建神煞小表（10 项封闭）" },
    "luck_ten_god": { "args": { "god": "ten_god" }, "engine": "pending:dayun", "src": "lunar-js getYun→DaYun 干支十神，待接线；requires=dayun" },
    "luck_element": { "args": { "el": "element" }, "engine": "pending:dayun", "src": "大运干支五行" },
    "luck_twelve_stage": { "args": { "stage": "twelve_stage" }, "engine": "pending:dayun", "src": "日主于大运支长生宫" },
    "ming_gua": { "args": { "gua": "direction8" }, "engine": "ready", "src": "core.js mingGua" },
    "ming_gua_group": { "args": { "v": "east|west" }, "engine": "ready", "src": "core.js isEast" },
    "facing_mountain": { "args": { "shan": "mountain24" }, "engine": "ready", "src": "core.js mountainAt" },
    "sitting_mountain": { "args": { "shan": "mountain24" }, "engine": "ready", "src": "core.js directionReading" },
    "facing_gua": { "args": { "gua": "direction8" }, "engine": "ready", "src": "core.js trigramAt" },
    "sitting_gua": { "args": { "gua": "direction8" }, "engine": "ready", "src": "core.js" },
    "younian_star": { "args": { "base": "direction8", "target": "direction8", "star": "younian_star" }, "engine": "ready", "src": "core.js bazhaiStar" },
    "year_zhi": { "args": { "zhi": "zhi" }, "engine": "ready", "src": "当年年支（流年参数）" },
    "year_gan": { "args": { "gan": "gan" }, "engine": "ready", "src": "当年年干" },
    "annual_sha_at": { "args": { "sha": "annual_sha", "shan": "mountain24|direction8" }, "engine": "pending:xinji_table", "src": "协纪辨方年神方位表（由 G2 编译同时产出 tables/annual-shensha.json）" }
  },
  "policy": {
    "quote_rule": "quote 必须是该句 orig 的精确子串（机器校验）",
    "threshold_rule": "数值阈值只准来自该句 orig 明文或该句 quant 字段",
    "conf_rule": "annotated conf=low 的句子整句 skip=conf_low",
    "redline_rule": "consequence 命中 blacklist_class 任一类（含隐含指向，如『刎颈之鬼』『寿年终』『产亡』『私通』）→ 整句 skip=redline_consequence，宁杀勿放",
    "gender_rule": "性别限定句必须带 gender 谓词，缺失即 skip=fragment_incomplete",
    "self_contained_rule": "前件或后件缺一即 skip=fragment_incomplete（张楠拆古歌碎句重灾区）",
    "no_invention_rule": "谓词名/枚举值不在本表 → 该句 skip=other 并在 note 说明，禁止造词"
  }
}
