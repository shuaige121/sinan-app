  "predicates": {
    "gender": { "args": { "v": "gender" }, "engine": "ready", "src": "输入" },
    "day_master": { "args": { "gan": "gan" }, "engine": "ready", "src": "core.js computeBazi" },
    "day_master_element": { "args": { "el": "element" }, "engine": "ready", "src": "core.js" },
    "day_master_strength": { "args": { "v": "strength" }, "engine": "ready", "src": "core.js:276 扶抑比值模型（二值）；句中要求 无根/自旺/太过 等细分等级时不得用本谓词，整句 skip=requires_strength_score" },
