# ============================================================
#  www/_headers — 本文件就是唯一来源，直接编辑它。
#
#  2026-08-13 核查：文件头原本写着「由 deploy/assemble.sh 自动生成，请勿手工编辑」，
#  但本仓库里既没有 deploy/assemble.sh，也没有它所称的 web/_headers 与 daos/_headers；
#  发布方式是 `wrangler pages deploy www` 直传（见 README），不经过任何 assemble 步骤。
#  那句注释是从旧工程带过来的、已经失效的说明，照它办会让人不敢改这个文件。
# ============================================================

# ── 主站 dao（/）──────────────────────────────────────────
# CF Pages 缓存策略：JS/CSS 即时再验证，部署立即生效（此前 max-age=14400 导致客户端钉旧版 4 小时）
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate

# ── 典籍阁 dianjige（/dian/）──────────────────────────────
# 安全头 + CSP：覆盖 /dian/ 全部响应（js/css/json 亦受 nosniff 等保护）；
# 本块不含 Cache-Control，避免与下方缓存规则被 CF Pages 逗号合并成脏头。
/dian/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # style-src/font-src 放行 Google Fonts：index.html 一直挂着 Noto Serif SC 的 link，
  # 但旧 CSP 把它拦掉了，典籍阁从来只用系统宋体渲染（2026-08-12 真实浏览器 console 才发现）。
  # script-src 放行 CF Insights beacon，同样是一直被拦、白报错。
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'self' https://dao.leonardchow.work

# 缓存策略：每类路径唯一、互不重叠。js/css 即时再验证（部署秒生效，
# 对齐主站 /js/*、/css/*，根治旧版本被长缓存钉死的问题）。
/dian/js/*
  Cache-Control: public, max-age=0, must-revalidate
/dian/css/*
  Cache-Control: public, max-age=0, must-revalidate
# JSON 数据（书目/正文/搜索索引）：短缓存 + stale-while-revalidate。
/dian/*.json
  Cache-Control: public, max-age=600, stale-while-revalidate=3600
